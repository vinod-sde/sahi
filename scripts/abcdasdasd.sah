/**
* ondhu
* @param $Firstname - 
* @param $Lastname - 
*/
function ondhu($Firstname, $Lastname) {
_setValue(_textbox("firstname"),$Firstname);
_setValue(_textbox("lastname"),$Lastname);

}
/**
* yeardu
* @param $Email - 
* @param $Telephone - 
*/
function yeardu($Email, $Telephone) {
_setValue(_emailbox("email"),$Email);
_setValue(_telephonebox("telephone"),$Telephone);

}
/**
* mooru
* @param $Firstname - 
* @param $Lastname - 
* @param $Email - 
*/
function mooru($Firstname, $Lastname, $Email) {
_setValue(_textbox("firstname"),$Firstname);
_setValue(_textbox("lastname"),$Lastname);
_setValue(_emailbox("email"),$Email);

}
