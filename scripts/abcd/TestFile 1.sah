function VerifyUser() {
	_assertEqual("Your Account Has Been Created!", 	_getText(_heading1(0)));
	_click(_link("Laptops & Notebooks"));
	_click(_link("Windows (0)"));
}

function Logout() {
	_click(_link("My Account"));
	_click(_link("Logout"));
}
