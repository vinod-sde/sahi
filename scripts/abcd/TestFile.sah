* @datagen $Email1 {"type":"text","min-length":"5","max-length":"5","include-alphabet":"true"}
*/
function Abcdaa($Firstname, $Lastname, $Email, $Email1) {
	_click(_link("My Account"));
	_click(_link("Register"));
	_setValue(_textbox("firstname"), $Firstname);
	_setValue(_textbox("lastname"), $Lastname);
	_setValue(_emailbox("email1"), $Email1);
	_click(_div("content"));
}

