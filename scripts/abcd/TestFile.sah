
/**
* Typo
* @param $Object - 
* @param $Firstname - 
* @paramobject Object.Lastname, Object.Email, Firstname
* @datagen $Firstname {"type":"text","min-length":"4","max-length":"4","include-alphabet":"true"}
* @datagen $Object.Lastname {"type":"text","min-length":"6","max-length":"6","include-alphabet":"true"}
* @datagen $Object.Email {"type":"text","min-length":"5","max-length":"5","include-alphabet":"true"}
*/
function Typo($Firstname, $Object) {
	_click(_link("My Account"));
	_click(_link("Register"));
	_setValue(_textbox("firstname"), $Object.Firstname);
	_setValue(_textbox("lastname"), $Object.Lastname);
	_setValue(_emailbox("email1"), $Object.Email);
	_click(_div("content"));
}

